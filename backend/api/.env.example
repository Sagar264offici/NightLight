# Backend environment — copy to .env and fill with real values.
# NEVER commit the real .env file.

# MongoDB Atlas connection string (required)
MONGODB_URI=

# Database name (optional, default: nightlight)
MONGODB_DB_NAME=

# RapidAPI key for the lyrics provider (required for lyrics)
RAPIDAPI_KEY=

# HTTP port (optional, default: 8787)
PORT=

# Mumbai-egress search forwarder (optional but recommended in production).
# JioSaavn ranks by server-IP geography; without this, US egress omits
# global hits from search. Deploy backend/search-proxy to Vercel (bom1),
# then set these two values identically on both sides. Unset = direct.
SEARCH_PROXY_URL=
SEARCH_PROXY_SECRET=
