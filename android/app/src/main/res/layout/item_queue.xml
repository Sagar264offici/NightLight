<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/queue_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/queue_artwork"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_artwork_placeholder"
        android:contentDescription="@string/artwork_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queue_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nightlight_cream"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/queue_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nightlight_cream_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/queue_now_playing"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@string/now_playing_desc"
        android:src="@drawable/ic_music_note"
        app:tint="@color/nightlight_gold"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/queue_more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_more"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/nightlight_cream_dim" />
</LinearLayout>