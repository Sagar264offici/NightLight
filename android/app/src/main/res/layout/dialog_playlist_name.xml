<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="4dp"
    app:boxStrokeColor="@color/nightlight_gold"
    app:hintEnabled="true"
    app:hintTextColor="@color/nightlight_cream_dim">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/playlist_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/playlist_name_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/nightlight_cream"
        android:textColorHint="@color/nightlight_cream_dim" />
</com.google.android.material.textfield.TextInputLayout>