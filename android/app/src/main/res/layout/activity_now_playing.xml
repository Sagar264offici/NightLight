<?xml version="1.0" encoding="utf-8"?>
<!-- Cinematic Now Playing: full-bleed artwork atmosphere, floating artwork,
     glass bottom panel with premium transport + mode actions. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_now_playing">

    <!-- Artwork atmosphere bleeding behind everything -->
    <ImageView
        android:id="@+id/np_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.52"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Readability scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_art" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/np_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/nightlight_cream" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.35"
                android:text="@string/now_playing_desc"
                android:textAllCaps="true"
                android:textColor="@color/nightlight_cream_dim"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/np_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_share"
                android:src="@drawable/ic_share"
                app:tint="@color/nightlight_cream_dim" />
        </LinearLayout>

        <!-- Artwork stage: floating art above the atmosphere -->
        <FrameLayout
            android:id="@+id/np_artwork_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <View
                android:id="@+id/np_artwork_ring"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_artwork_stage" />

            <ImageView
                android:id="@+id/np_artwork"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_artwork_placeholder_round"
                android:contentDescription="@string/artwork_desc"
                android:elevation="12dp"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <!-- Glass control panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_panel"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/np_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:textColor="@color/nightlight_ivory"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/np_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:textColor="@color/nightlight_cream_dim"
                android:textSize="13sp" />

            <!-- Progress -->
            <SeekBar
                android:id="@+id/np_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:minHeight="36dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/bg_seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/bg_seek_thumb"
                android:thumbOffset="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/np_position"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/nightlight_cream_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/np_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_weight="1"
                    android:textColor="@color/nightlight_cream_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Transport row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/np_shuffle"
                        android:layout_width="@dimen/control_button"
                        android:layout_height="@dimen/control_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_shuffle"
                        android:padding="12dp"
                        android:src="@drawable/ic_shuffle"
                        app:tint="@color/nightlight_cream_dim" />

                    <TextView
                        android:id="@+id/np_shuffle_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:text="SMART"
                        android:textColor="@color/nightlight_cream_dim"
                        android:textSize="8sp" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/np_previous"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_previous"
                    android:padding="14dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/nightlight_cream" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/np_play_pause"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_play_button"
                    android:contentDescription="@string/cd_play_pause"
                    android:padding="24dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/nightlight_navy_deep" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/np_next"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_next"
                    android:padding="14dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/nightlight_cream" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/np_repeat"
                    android:layout_width="@dimen/control_button"
                    android:layout_height="@dimen/control_button"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_repeat"
                    android:padding="12dp"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/nightlight_cream_dim" />
            </LinearLayout>

            <!-- Secondary actions: like · lyrics · queue -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/np_like"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageButton
                        android:id="@+id/np_like_icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@null"
                        android:contentDescription="@string/action_like"
                        android:padding="2dp"
                        android:src="@drawable/ic_favorite_border"
                        app:tint="@color/nightlight_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/action_like"
                        android:textColor="@color/nightlight_cream_dim"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/np_lyrics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageButton
                        android:id="@+id/np_lyrics_icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@null"
                        android:contentDescription="@string/lyrics_desc"
                        android:padding="2dp"
                        android:src="@drawable/ic_lyrics"
                        app:tint="@color/lyrics_icon_tint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lyrics_title"
                        android:textColor="@color/nightlight_cream_dim"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/np_queue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageButton
                        android:id="@+id/np_queue_icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@null"
                        android:contentDescription="@string/action_queue"
                        android:padding="2dp"
                        android:src="@drawable/ic_queue_music"
                        app:tint="@color/nightlight_cream" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/action_queue"
                        android:textColor="@color/nightlight_cream_dim"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
