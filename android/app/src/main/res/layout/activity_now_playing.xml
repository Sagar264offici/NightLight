<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_now_playing"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/np_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.25"
            android:text="@string/now_playing_desc"
            android:textColor="@color/nightlight_cream_dim"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/np_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_share"
            android:src="@drawable/ic_share"
            app:tint="@color/nightlight_cream_dim" />

        <ImageButton
            android:id="@+id/np_lyrics"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lyrics_desc"
            android:src="@drawable/ic_lyrics"
            app:tint="@color/nightlight_cream" />
    </LinearLayout>

    <!-- Artwork stage: gold ring + rounded square art -->
    <FrameLayout
        android:id="@+id/np_artwork_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <View
            android:id="@+id/np_artwork_ring"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_artwork_stage" />

        <ImageView
            android:id="@+id/np_artwork"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="false"
            android:background="@drawable/bg_artwork_placeholder_round"
            android:contentDescription="@string/artwork_desc"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- Meta -->
    <TextView
        android:id="@+id/np_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:maxLines="2"
        android:textColor="@color/nightlight_cream"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/np_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:letterSpacing="0.04"
        android:maxLines="2"
        android:textColor="@color/nightlight_cream_dim"
        android:textSize="14sp" />

    <!-- Progress -->
    <SeekBar
        android:id="@+id/np_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:max="1000"
        android:progressTint="@color/nightlight_gold"
        android:progressBackgroundTint="@color/nightlight_navy_soft"
        android:thumbTint="@color/nightlight_gold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/np_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/nightlight_cream_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/np_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_weight="1"
            android:textColor="@color/nightlight_cream_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/np_shuffle"
            android:layout_width="@dimen/control_button"
            android:layout_height="@dimen/control_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_shuffle"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/nightlight_cream_dim" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/np_previous"
            android:layout_width="@dimen/control_button"
            android:layout_height="@dimen/control_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_previous"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/nightlight_cream" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/np_play_pause"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_play_button"
            android:contentDescription="@string/cd_play_pause"
            android:src="@drawable/ic_play"
            app:tint="@color/nightlight_navy_deep" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/np_next"
            android:layout_width="@dimen/control_button"
            android:layout_height="@dimen/control_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_next"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/nightlight_cream" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/np_repeat"
            android:layout_width="@dimen/control_button"
            android:layout_height="@dimen/control_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_repeat"
            android:src="@drawable/ic_repeat"
            app:tint="@color/nightlight_cream_dim" />
    </LinearLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/np_like"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_like"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/nightlight_gold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/np_queue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_queue"
            android:src="@drawable/ic_queue_music"
            app:tint="@color/nightlight_cream" />
    </LinearLayout>
</LinearLayout>