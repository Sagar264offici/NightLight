<?xml version="1.0" encoding="utf-8"?>
<!-- Soft luminous frame behind the album artwork: two rings read as a glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="@color/transparent" />
            <stroke
                android:width="6dp"
                android:color="#2AE9C46A" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <solid android:color="@color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="#66E9C46A" />
        </shape>
    </item>
</layer-list>
