<?xml version="1.0" encoding="utf-8"?>
<!-- Premium gold play button with a soft highlight gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#4DE9C46A" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#C9973F"
                android:startColor="#F6D98B" />
            <stroke
                android:width="1dp"
                android:color="#8CF3E3B0" />
        </shape>
    </item>
</layer-list>
