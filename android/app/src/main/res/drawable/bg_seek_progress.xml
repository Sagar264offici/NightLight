<?xml version="1.0" encoding="utf-8"?>
<!-- Luminous seek bar: fixed 36dp touch target, 6dp visible track so the
     progress line is always clearly visible on dark backgrounds. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:top="15dp"
        android:bottom="15dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>

    <item
        android:id="@android:id/secondaryProgress"
        android:top="15dp"
        android:bottom="15dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#44FFFFFF" />
        </shape>
    </item>

    <item
        android:id="@android:id/progress"
        android:top="15dp"
        android:bottom="15dp">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#FFE9B86A"
                    android:centerColor="#E9C46A"
                    android:endColor="#FFF6DE" />
            </shape>
        </clip>
    </item>
</layer-list>
