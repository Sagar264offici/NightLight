<?xml version="1.0" encoding="utf-8"?>
<!-- Mood chip (selected): electric blue->cyan gradient with a luminous rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="0"
                android:startColor="#5B8DEF"
                android:centerColor="#4A6FE0"
                android:endColor="#3A56C8" />
            <stroke
                android:width="1dp"
                android:color="#B85FDDE8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:startColor="#5CFFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
