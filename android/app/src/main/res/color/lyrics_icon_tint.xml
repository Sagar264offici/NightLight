<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-aware tint for the LYRICSSS.png lyrics icon (provided asset, geometry preserved).
     normal: quiet ivory - pressed: gold - activated (lyrics open): luminous gold
     disabled: muted - all via single-tint of the black silhouette -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/nightlight_gold" />
    <item android:state_activated="true" android:color="@color/nightlight_gold" />
    <item android:state_enabled="false" android:color="@color/nightlight_muted" />
    <item android:color="@color/nightlight_cream" />
    <item android:color="@color/nightlight_cream" />
</selector>
