# Backend environment — copy to .env and fill with real values.
# NEVER commit the real .env file.

# MongoDB Atlas connection string (required)
MONGODB_URI=

# Database name (optional, default: nightlight)
MONGODB_DB_NAME=

# RapidAPI key for the lyrics provider (required for lyrics)
RAPIDAPI_KEY=

# HTTP port (optional, default: 8787)
PORT=
